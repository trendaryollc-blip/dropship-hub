# =============================================================================
# DROPSHIP HUB — ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# APP (required)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
OWNER_UID=
OWNER_EMAIL=

# -----------------------------------------------------------------------------
# FIREBASE — CLIENT (exposed to browser, required)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Web Push VAPID key (optional — enables browser push notifications)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# -----------------------------------------------------------------------------
# FIREBASE — ADMIN SDK (server only, required)
# -----------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# Alternative: provide the full service account JSON as a single env var
FIREBASE_SERVICE_ACCOUNT=
# Optional numeric project id override (falls back to NEXT_PUBLIC_FIREBASE_PROJECT_ID)
FIREBASE_PROJECT_ID=

# -----------------------------------------------------------------------------
# SECURITY (required)
# -----------------------------------------------------------------------------
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Token revocation checking (default: true). Set to false only for debugging.
# CHECK_TOKEN_REVOCATION=true

# Secret for server-to-server cron triggers (e.g. the GitHub Actions
# "Daily Intelligence Digest" workflow). Use a long random value and send it
# as: Authorization: Bearer <CRON_SECRET>. When set, POST /api/digest accepts
# this token in place of a user ID token and runs as the OWNER_UID account.
CRON_SECRET=

# -----------------------------------------------------------------------------
# AI PROVIDERS (at least one required)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_API_KEYS=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
GROQ_API_KEY=
GROQ_API_KEYS=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
# Additional AI providers (optional)
COHERE_API_KEY=
TOGETHER_API_KEY=
HUGGINGFACE_API_KEY=
FIREWORKS_API_KEY=
OPENROUTER_API_KEY=
REPLICATE_API_KEY=
HPC_API_KEY=

# -----------------------------------------------------------------------------
# SHOPIFY (optional — for store integration)
# -----------------------------------------------------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_products,read_orders,write_orders,read_inventory,write_inventory,read_fulfillments,write_fulfillments
SHOPIFY_REDIRECT_URI=https://yourapp.vercel.app/api/store/shopify/callback
SHOPIFY_WEBHOOK_SECRET=
# Legacy: env-based single-store access (optional, for direct API proxy)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# WOOCOMMERCE (optional — for store integration)
# -----------------------------------------------------------------------------
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# -----------------------------------------------------------------------------
# TRENDARYO (optional)
# -----------------------------------------------------------------------------
TRENDARYO_API_URL=
TRENDARYO_API_KEY=
TRENDARYO_STORE_URL=
TRENDARYO_JWT_SECRET=
TRENDARYO_ADMIN_UID=

# -----------------------------------------------------------------------------
# PRODUCT DATA APIS (optional)
# -----------------------------------------------------------------------------
# Comma-separated key pools are supported for every provider below
# (e.g. CJ_API_KEYS=key1,key2). The app rotates through the pool and cools
# down keys that hit their free-tier quota. Single-key names still work.
ALIEXPRESS_API_KEY=
CJ_API_KEY=
CJ_API_KEYS=
EBAY_APP_ID=
EBAY_CERT_ID=

# -----------------------------------------------------------------------------
# WEB SEARCH (optional)
# -----------------------------------------------------------------------------
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
# SerpAPI: canonical pool var is SERPAPI_KEYS (comma-separated for multiple
# free accounts). Legacy aliases SERP_API_KEY / SERPAPI_KEY are also read.
# Get keys at https://serpapi.com/manage/api-key
SERPAPI_KEYS=
SERP_API_KEY=
RAINFOREST_API_KEY=
RAINFOREST_API_KEYS=
KEEPA_API_KEY=
KEEPA_API_KEYS=

# -----------------------------------------------------------------------------
# SCRAPING (optional)
# -----------------------------------------------------------------------------
SCRAPER_API_KEY=
SCRAPER_API_KEYS=
ZENROWS_API_KEY=
SCRAPINGBEE_API_KEY=
CRAWLBASE_API_KEY=
WEBSCRAPING_AI_KEY=

# -----------------------------------------------------------------------------
# EMAIL (optional)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
SENDGRID_API_KEY=

# -----------------------------------------------------------------------------
# AD PLATFORM OAUTH (optional — for campaign management)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://yourapp.com/api/ad-connections/callback
NEXT_PUBLIC_GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REDIRECT_URI=https://yourapp.com/api/ad-connections/callback
AD_PLATFORM_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# UPSTASH REDIS (required for production rate limiting)
# Without this, rate limiting falls back to an in-memory store that does NOT
# persist across serverless cold starts on Vercel.
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# INNGEST (optional — for background jobs)
# -----------------------------------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# -----------------------------------------------------------------------------
# STRIPE (optional — for billing)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=
