{
  "functions": {
    "src/app/api/ai/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/ai/*/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/platforms/*/route.ts": {
      "maxDuration": 15
    },
    "src/app/api/store/*/route.ts": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        { "key": "Pragma", "value": "no-cache" }
      ]
    }
  ]
}
