rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the signed-in user is the app owner
    function isOwner() {
      return request.auth != null && request.auth.uid == "WBH7KDGxsaOPTYrYXjd4oZLgu5T2";
    }

    // ──────────────────────────────────────────────────
    // USER PROFILES — self read/write, owner full access
    // ──────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isOwner());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || isOwner());
      allow delete: if isOwner();

      // User subcollections (settings, usage, etc.)
      match /{document=**} {
        allow read: if request.auth != null && (request.auth.uid == userId || isOwner());
        allow write: if request.auth != null && (request.auth.uid == userId || isOwner());
      }
    }

    // ──────────────────────────────────────────────────
    // COLLECTION GROUP: settings (subscription info)
    // Used by admin stats to count active subscriptions
    // ──────────────────────────────────────────────────
    match /{document=**} {
      allow read: if isOwner();
    }

    // ──────────────────────────────────────────────────
    // PLATFORMS — any authenticated user reads, owner writes
    // ──────────────────────────────────────────────────
    match /platforms/{platformId} {
      allow read: if request.auth != null;
      allow write: if isOwner();
    }

    // ──────────────────────────────────────────────────
    // SYSTEM SETTINGS — owner only
    // ──────────────────────────────────────────────────
    match /system/{doc} {
      allow read, write: if isOwner();
    }

    // ──────────────────────────────────────────────────
    // SEARCH HISTORY — owner read, authenticated user write
    // ──────────────────────────────────────────────────
    match /searchHistory/{doc} {
      allow read: if isOwner();
      allow create: if request.auth != null;
    }

    // ──────────────────────────────────────────────────
    // REJECT ALL OTHER ACCESS
    // ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
